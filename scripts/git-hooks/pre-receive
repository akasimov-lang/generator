#!/bin/sh
set -eu
repo=$(pwd)
worktree=${PAGEPILOT_WORK_TREE:-/home/akasimov/generator}
cd "$worktree"
while read -r old new ref; do
  [ "$ref" = refs/heads/main ] || continue
  git --git-dir="$repo" merge-base --is-ancestor "$old" "$new" || {
    echo 'Production main requires a fast-forward update.' >&2; exit 1;
  }
  index=$(mktemp)
  rm -f "$index"
  trap 'rm -f "$index"' EXIT HUP INT TERM
  export GIT_INDEX_FILE="$index"
  git --git-dir="$repo" read-tree "$old"
  changed=$(git --git-dir="$repo" --work-tree="$worktree" diff --name-only "$old" --)
  untracked=$(git --git-dir="$repo" --work-tree="$worktree" ls-files --others --exclude-standard)
  if [ -n "$changed$untracked" ]; then
    echo 'Deploy rejected: production has changes outside Git. Reconcile them before pushing.' >&2
    printf '%s\n%s\n' "$changed" "$untracked" >&2
    exit 1
  fi
  rm -f "$index"
  unset GIT_INDEX_FILE
  trap - EXIT HUP INT TERM
done
