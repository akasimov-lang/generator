<button class="pp-menu-toggle" type="button" aria-controls="pp-main-menu" aria-expanded="false" aria-label="Otwórz menu"><span aria-hidden="true">☰</span><span>Menu</span></button>
<nav id="pp-main-menu" class="pp-main-menu" aria-label="Menu główne">
  <ul>{{#each headerMenu}}
    <li><a href="{{this.slug}}">{{this.title}}</a>
      {{#if this.children}}<ul>{{#each this.children}}
        <li><a href="{{this.slug}}">{{this.title}}</a>
          {{#if this.children}}<ul>{{#each this.children}}<li><a href="{{this.slug}}">{{this.title}}</a></li>{{/each}}</ul>{{/if}}
        </li>{{/each}}</ul>{{/if}}
    </li>{{/each}}
  </ul>
</nav>
{{#unless amp}}
<script>
(()=>{const button=document.querySelector('.pp-menu-toggle');const nav=document.getElementById('pp-main-menu');if(!button||!nav)return;
const setOpen=(open)=>{button.setAttribute('aria-expanded',String(open));button.setAttribute('aria-label',open?'Zamknij menu':'Otwórz menu');nav.classList.toggle('pp-open',open);};
button.addEventListener('click',()=>setOpen(button.getAttribute('aria-expanded')!=='true'));
nav.addEventListener('click',event=>{if(event.target.closest('a'))setOpen(false);});
document.addEventListener('click',event=>{if(!nav.contains(event.target)&&!button.contains(event.target))setOpen(false);});
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&button.getAttribute('aria-expanded')==='true'){setOpen(false);button.focus();}});
window.matchMedia('(min-width: 1101px)').addEventListener('change',()=>setOpen(false));
})();
</script>
{{/unless}}
