#!/bin/sh
set -eu

APP_DIR="/opt/generator/app"
REPO_DIR="/opt/generator/repo.git"
BRANCH="main"

while read oldrev newrev refname; do
  if [ "$refname" != "refs/heads/$BRANCH" ]; then
    continue
  fi

  mkdir -p "$APP_DIR"
  GIT_WORK_TREE="$APP_DIR" git --git-dir="$REPO_DIR" checkout -f "$BRANCH"

  cd "$APP_DIR"

  if [ ! -f ".env" ]; then
    secret_key="$(openssl rand -hex 32)"
    db_password="$(openssl rand -hex 20)"
    admin_password="$(openssl rand -hex 12)"
    cat > .env <<EOF
APP_ENV=production
APP_PUBLIC_URL=http://91.199.133.86
SECRET_KEY=$secret_key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=$admin_password

POSTGRES_DB=generator
POSTGRES_USER=generator
POSTGRES_PASSWORD=$db_password
DATABASE_URL=postgresql+psycopg2://generator:$db_password@postgres:5432/generator

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

BACKEND_CORS_ORIGINS=http://91.199.133.86,http://localhost:5173,http://localhost:8080
EOF
    chmod 600 .env
    printf "admin\n%s\n" "$admin_password" > ADMIN_PASSWORD.txt
    chmod 600 ADMIN_PASSWORD.txt
    echo "Created production .env with generated secrets."
    echo "Admin password saved to $APP_DIR/ADMIN_PASSWORD.txt"
  fi

  docker-compose up -d --build
  docker-compose ps
done
